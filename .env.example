# Copy to .env and fill in. Never commit .env.
AUTODJ_GEMINI_TRANSPORT=cli        # or: api
# AUTODJ_GEMINI_MODEL=             # model ID your key can access (api mode)
# GEMINI_API_KEY=                  # server-side only
AUTODJ_COMFY_DIR=/path/to/ComfyUI
AUTODJ_COMFY_BASE=/path/to/comfy-base
AUTODJ_WEB_PORT=8300
